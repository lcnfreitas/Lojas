                {
                  "type": "EXEC",
                  "name": "1InstallSoftware",
                  "description": "",
                  "attrs": {
                    "type": "",
                    "script": "#!\/bin\/bash\nset -ex\n\n# 1. Instala Docker e Git\nsudo dnf -y update\nsudo dnf config-manager --add-repo https:\/\/download.docker.com\/linux\/centos\/docker-ce.repo || true\nsudo dnf -y install docker-ce docker-ce-cli containerd.io git\nsudo systemctl enable --now docker\n\n# 2. Clona o repositorio traduzido do GitHub\ncd \/home\/rocky\nsudo rm -rf Lojas || true\ngit clone https:\/\/github.com\/lcnfreitas\/Lojas.git\ncd \/home\/rocky\/Lojas\n\n# 3. Substitui os placeholders no config.js LOCAL antes de construir o container\nsudo sed -i 's#REPLACE_DB_DIALECT#mysql#g' config\/config.js\nsudo sed -i \"s#REPLACE_DB_HOST_ADDRESS#@@{MySQL.address}@@#g\" config\/config.js\nsudo sed -i \"s#REPLACE_DB_NAME#@@{db_name}@@#g\" config\/config.js\nsudo sed -i \"s#REPLACE_DB_USER_NAME#@@{db_username}@@#g\" config\/config.js\nsudo sed -i \"s#REPLACE_DB_PASSWORD#@@{db_password}@@#g\" config\/config.js\n\n# 4. Constroi a imagem (no-cache garante que o config.js atualizado vai para dentro da imagem)\nsudo docker build --no-cache -t fiesta-app .\nsudo docker rm -f fiesta-web || true\nsudo docker run -d --name fiesta-web --restart always -p 80:80 fiesta-app\n\n# 5. Executa os seeders dentro do container com o config.js ja configurado\nsudo docker exec fiesta-web npx sequelize-cli db:seed:all || true",
                    "script_type": "sh",
                    "command_line_args": "",
                    "exit_status": [],
                    "login_credential_local_reference": {
