                {
                  "type": "EXEC",
                  "name": "StageRecoveryScript",
                  "description": "",
                  "attrs": {
                    "type": "",
                    "script": "#!\/bin\/bash\nset -ex\n\n# Cria o arquivo do script de DR dentro da VM\nsudo tee \/usr\/local\/sbin\/production_vm_recovery << 'EOF'\n#!\/bin\/bash\nset -ex\n\n# 1. Pega a nova rede da interface principal (ex: eth0)\nNEW_NET=$(ip route get 1 | awk '{print $NF;exit}')\nNEW_NET=$(echo $NEW_NET | sed 's\/\\.[0-9]*$\/\/')\n\n# 2. Descobre o ultimo octeto do IP antigo que esta no config.js atual\nDB_ADDRESS=$(awk '\/REPLACE_DB_HOST_ADDRESS|host:\/{print}' \/home\/rocky\/Lojas\/config\/config.js | grep -oE '[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}' | head -1)\nLAST_OCTET=$(awk -F\".\" '{print $4}' <<< $DB_ADDRESS)\n\n# 3. Monta o novo IP do banco\nNEW_IP=\"${NEW_NET}.${LAST_OCTET}\"\n\n# 4. Atualiza o IP no arquivo do host\nsudo sed -i \"s\/$DB_ADDRESS\/$NEW_IP\/g\" \/home\/rocky\/Lojas\/config\/config.js\n\n# 5. Reconstroi a imagem Docker para injetar a nova configuracao\ncd \/home\/rocky\/Lojas\nsudo docker build --no-cache -t fiesta-app .\n\n# 6. Remove o conteiner antigo e sobe o novo com a configuracao atualizada\nsudo docker rm -f fiesta-web || true\nsudo docker run -d --name fiesta-web --restart always -p 80:80 fiesta-app\nEOF\n\n# D\u00e1 permiss\u00e3o de execu\u00e7\u00e3o para o script de DR\nsudo chmod +x \/usr\/local\/sbin\/production_vm_recovery\n\n",
